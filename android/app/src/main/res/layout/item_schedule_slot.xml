<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/table_border"
    android:orientation="vertical"
    android:paddingBottom="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvSlotTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="1dp"
            android:layout_weight="1"
            android:background="@color/card_bg"
            android:gravity="center"
            android:paddingHorizontal="6dp"
            android:paddingVertical="9dp"
            android:text="00:00 — 00:30"
            android:textColor="@color/ink_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvSlotStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/status_on_bg"
            android:gravity="center"
            android:paddingHorizontal="6dp"
            android:paddingVertical="9dp"
            android:text="Світло є"
            android:textColor="@color/status_on_fg"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
